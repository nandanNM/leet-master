{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon -e ts,json --exec \"tsx ./src/index.ts\" --delay 1s",
    "build": "npm run db:generate && tsc",
    "start": "node --env-file .env dist/src/index.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy-public": "copyfiles -u 1 public/**/* dist/public"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@dotenvx/dotenvx": "^1.53.0",
    "axios": "^1.9.0",
    "better-auth": "^1.5.3",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.43.1",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.0",
    "openai": "^6.27.0",
    "pg": "^8.16.0",
    "uuid": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.18",
    "@types/pg": "^8.18.0",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
